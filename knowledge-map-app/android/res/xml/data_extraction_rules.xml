<?xml version="1.0" encoding="utf-8"?>
<!-- 系统备份和换机迁移（Android 12 起）：设备同步的钥匙和密文（files/kmsync/，#1）不带走 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="kmsync/" />
        <exclude domain="file" path="textbooks/" />
        <exclude domain="sharedpref" path="km_textbook_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kmsync/" />
        <exclude domain="file" path="textbooks/" />
        <exclude domain="sharedpref" path="km_textbook_auth.xml" />
    </device-transfer>
</data-extraction-rules>
